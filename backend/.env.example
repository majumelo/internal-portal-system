# Porta em que a API sobe
PORT=3333

# Conexão com o PostgreSQL (usada pela API e pelos comandos do Prisma)
# Formato: postgresql://USUARIO:SENHA@HOST:PORTA/BANCO
DATABASE_URL=postgresql://postgres:sua_senha@localhost:5432/internal_bd

# Autenticação (JWT)
JWT_SECRET=troque_por_um_segredo_longo_e_aleatorio
JWT_EXPIRES_IN=8h

# Origens autorizadas a consumir a API (separadas por vírgula)
CORS_ORIGIN=http://localhost:5173
